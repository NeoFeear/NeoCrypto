[Unit]
Description=Crypto paper-trading simulator - moteur live (aucun ordre reel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cryptosim
Group=cryptosim
WorkingDirectory=/opt/crypto-sim
ExecStart=/opt/crypto-sim/.venv/bin/python /opt/crypto-sim/live_engine.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/crypto-sim

[Install]
WantedBy=multi-user.target
